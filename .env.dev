# Dev environment — matches services in docker-compose.dev.yml
# Usage: cp .env.dev .env  (then fill in APP_KEY, JELLYFIN_*, TMDB_API_KEY)

NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=debug

APP_KEY=                        # node ace generate:key

# SQLite (no container needed)
DB_CONNECTION=sqlite

# Redis (docker-compose.dev.yml → redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Jellyfin (point at your local/remote instance)
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# TMDB
TMDB_API_KEY=

# Radarr (optional)
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Sonarr (optional)
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# SMTP → Mailpit (docker-compose.dev.yml → mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@streamyapi.local

# Ntfy (docker-compose.dev.yml → ntfy)
NTFY_URL=http://localhost:8080
NTFY_TOPIC=streamyapi-dev

# Discord (optional)
DISCORD_WEBHOOK_URL=

# Slack (optional)
SLACK_WEBHOOK_URL=
