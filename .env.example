# ============================================
# StreamyAPI — Configuration
# ============================================

# App
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
APP_KEY=                          # Générer avec: node ace generate:key
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie

# ============================================
# CORS (configure allowed origins for API access)
# ============================================
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# Database
# ============================================
# Options: sqlite, pg
DB_CONNECTION=sqlite

# SQLite (si DB_CONNECTION=sqlite)
# Le fichier sera créé automatiquement dans le volume Docker
# SQLITE_FILENAME=/app/data/streamy.db

# PostgreSQL (si DB_CONNECTION=pg)
# PG_HOST=postgres
# PG_PORT=5432
# PG_USER=streamy
# PG_PASSWORD=change-me-in-production
# PG_DB_NAME=streamy_api

# ============================================
# Jellyfin
# ============================================
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=                 # API key admin Jellyfin
# Secret pour les webhooks Jellyfin → StreamyAPI
JELLYFIN_WEBHOOK_SECRET=

# ============================================
# TMDB
# ============================================
TMDB_API_KEY=                     # Clé API TMDB v3 (https://www.themoviedb.org/settings/api)
# TMDB_BASE_URL=https://api.themoviedb.org/3

# ============================================
# Invitations & Parrainage
# ============================================
DEFAULT_INVITE_QUOTA=5            # Nombre d'invitations par utilisateur
ACCOUNT_EXPIRY_NOTIFICATION_DAYS=3 # Notifier X jours avant expiration

# ============================================
# Radarr / Sonarr
# ============================================
# Les instances sont configurées via l'API admin, pas ici
DOWNLOAD_SYNC_INTERVAL_SECONDS=60 # Fréquence de sync des téléchargements

# ============================================
# Notifications (optionnel)
# ============================================
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
